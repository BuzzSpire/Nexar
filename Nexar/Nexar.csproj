<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>2026.1008.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>Nexar - Modern HTTP Client for .NET</Title>
    <Description>A small, fluent HTTP client for .NET inspired by Rust's reqwest. Build a client once, describe each request through method chaining, and read responses lazily as JSON, text, bytes or streams. Includes typed errors, retries and DelegatingHandler support.</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/BuzzSpire/Nexar</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>ozel.png</PackageIcon>
    <RepositoryUrl>https://github.com/BuzzSpire/Nexar</RepositoryUrl>
    <PackageTags>http;httpclient;rest;api;requests;async;fluent;reqwest;retry;dotnet;csharp;net9</PackageTags>
    <PackageReleaseNotes>Release 2026.1008.0: Complete rewrite with a reqwest-style fluent API (NexarClient, ClientBuilder, RequestBuilder, NexarResponse, NexarException). Breaking change: the 2.x API has been removed. See "Migrating from 2.x" in the README.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>BuzzSpire.Nexar</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexar.Test" />
  </ItemGroup>

  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="/" />
    <None Update="ozel.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="System.Threading.RateLimiting" Version="9.0.0" />
  </ItemGroup>

</Project>
